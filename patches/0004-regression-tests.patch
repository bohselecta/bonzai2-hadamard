+int main(int argc, char ** argv) {
+    int ngl = 0;
+    if (argc == 3 && std::string(argv[1]) == "--ngl") {
+        ngl = std::stoi(argv[2]);
+    } else if (argc != 1) {
+        std::fprintf(stderr, "usage: %s [--ngl N]\n", argv[0]);
+        return EXIT_FAILURE;
+    }
+    llama_log_set([](ggml_log_level level, const char * text, void *) {
+        if (level == GGML_LOG_LEVEL_ERROR) {
+            error_log += text;
+        }
+    }, nullptr);
+    ggml_backend_load_all();
+    llama_backend_init();
+    const std::filesystem::path dir = "test-hadamard-fixtures";
+    bool owns_dir = false;
+    int result = EXIT_SUCCESS;
+    try {
+        if (ngl > 0) {
+            bool gpu = false;
+            for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+                const auto type = ggml_backend_dev_type(ggml_backend_dev_get(i));
+                gpu |= type == GGML_BACKEND_DEVICE_TYPE_GPU || type == GGML_BACKEND_DEVICE_TYPE_IGPU;
+            }
+            require(gpu, "GPU requested but no GPU backend is available");
+        }
+        owns_dir = std::filesystem::create_directory(dir);
+        require(owns_dir, "fixture directory already exists; use another working directory");
+        fixture_config cfg;
+        compare(dir, "identity", cfg, ngl);
+        cfg.explicit_signs = true;
+        compare(dir, "explicit-signs", cfg, ngl);
+        cfg.inverse = true;
+        compare(dir, "inverse-lookup", cfg, ngl);
+        cfg.tied = true;
+        compare(dir, "tied-output-v2", cfg, ngl);
+        cfg.tied = false;
+        cfg.quantized = true;
+        compare(dir, "q2-0", cfg, ngl);
+        cfg.quantized = false;
+        compare(dir, "q8-kv", cfg, ngl, GGML_TYPE_Q8_0);
+        cfg.moe = true;
+        compare(dir, "moe-matmul-id", cfg, ngl);
+        cfg.moe = false;
+        cfg.qwen35 = true;
+        compare(dir, "qwen35-hybrid", cfg, ngl);
+        cfg.grouped = true;
+        compare(dir, "qwen35-grouped-gdn", cfg, ngl);
+        cfg.qwen35 = cfg.grouped = false;
+        cfg.block = 128;
+        compare(dir, "block-128", cfg, ngl);
+
+        reject(dir, "missing-version", "requires prism.hadamard.version", [](auto * m) { gguf_remove_key(m, "prism.hadamard.version"); });
+        reject(dir, "bad-version", "unsupported prism.hadamard.version", [](auto * m) { gguf_set_val_u32(m, "prism.hadamard.version", 99); });
+        reject(dir, "oversized-block", "invalid prism.hadamard.block_size", [](auto * m) { gguf_set_val_u32(m, "prism.hadamard.block_size", 1u << 31); });
+        reject(dir, "zero-block", "invalid prism.hadamard.block_size", [](auto * m) { gguf_set_val_u32(m, "prism.hadamard.block_size", 0); });
+        reject(dir, "non-power-block", "invalid prism.hadamard.block_size", [](auto * m) { gguf_set_val_u32(m, "prism.hadamard.block_size", 96); });
+        reject(dir, "bad-transform", "unsupported prism.hadamard.transform", [](auto * m) { gguf_set_val_str(m, "prism.hadamard.transform", "other"); });
+        reject(dir, "bad-axis", "unsupported prism.hadamard.axis", [](auto * m) { gguf_set_val_str(m, "prism.hadamard.axis", "output"); });
+        reject(dir, "bad-sign-mode", "unsupported prism.hadamard.sign_mode", [](auto * m) { gguf_set_val_str(m, "prism.hadamard.sign_mode", "random"); });
+        reject(dir, "bad-sign-value", "sign values must be +/-1", [](auto * m) {
+            std::vector<int32_t> values(384, 1); values[0] = 0;
+            gguf_set_arr_data(m, "prism.hadamard.sign_values", GGUF_TYPE_INT32, values.data(), values.size());
+        });
+        reject(dir, "duplicate-sign-width", "duplicate prism.hadamard sign width", [](auto * m) {
+            const int32_t widths[] = { 128, 128 };
+            gguf_set_arr_data(m, "prism.hadamard.sign_widths", GGUF_TYPE_INT32, widths, 2);
+        });
+        reject(dir, "wrong-sign-type", "wrong array element type", [](auto * m) {
+            const float values[] = { 1.0f };
+            gguf_set_arr_data(m, "prism.hadamard.sign_values", GGUF_TYPE_FLOAT32, values, 1);
+        });
+        reject(dir, "short-sign-table", "invalid prism.hadamard sign width", [](auto * m) {
+            const int32_t values[] = { 1 };
+            gguf_set_arr_data(m, "prism.hadamard.sign_values", GGUF_TYPE_INT32, values, 1);
+        });
+        reject(dir, "unverified-weight", "not on a verified Hadamard-aware", [](auto * m) {
+            const char * names[] = { "blk.0.attn_norm.weight" };
+            gguf_set_arr_str(m, "prism.hadamard.weight_names", names, 1);
+        });
+        reject(dir, "unknown-weight", "weight not found", [](auto * m) {
+            const char * names[] = { "blk.999.attn_q.weight" };
+            gguf_set_arr_str(m, "prism.hadamard.weight_names", names, 1);
+        });
+        reject(dir, "bad-inverse-type", "array key not found", [](auto * m) { gguf_set_val_str(m, "prism.hadamard.inverse_weight_names", "token_embd.weight"); });
+        reject(dir, "bad-inverse-name", "not a verified inverse-after-lookup", [](auto * m) {
+            const char * names[] = { "output.weight" };
+            gguf_set_arr_str(m, "prism.hadamard.inverse_weight_names", names, 1);
+        });
+        reject(dir, "untagged-tied-output", "version 2 requires tied_output", [](auto * m) { gguf_set_val_u32(m, "prism.hadamard.version", 2); });
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "FAIL: %s\n", error.what());
+        result = EXIT_FAILURE;
+    }
+    if (owns_dir) {
+        std::filesystem::remove_all(dir);
+    }
+    llama_backend_free();
+    return result;
+}
